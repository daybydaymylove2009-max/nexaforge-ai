# 智核万炼 NexaForge AI - 配置文件示例
# 复制此文件为 .env 并根据需要修改

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 数据库配置
DB_FILE=nexaforge_v2.db
MAX_HISTORY=1000

# API 配置
API_VERSION=v1
API_PREFIX=/api/v1

# 认证配置 (可选)
# ENABLE_AUTH=false
# API_KEY=your-secret-api-key-here

# 速率限制 (可选)
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# 缓存配置
ENABLE_CACHE=true
CACHE_TTL=5

# 基准测试配置
BENCHMARK_CPU_DURATION=5.0
BENCHMARK_STORAGE_SIZE=100

# 前端配置
FRONTEND_DIST_DIR=frontend/dist
